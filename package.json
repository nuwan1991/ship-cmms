{
  "name": "navy-cmms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/platform/db/migrate-cli.ts",
    "dev": "tsx src/main.ts",
    "check:boundaries": "tsx tools/check-boundaries.ts",
    "verify": "npm run typecheck && npm run check:boundaries && npm test",
    "init-installation": "tsx src/platform/init-cli.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
