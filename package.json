{
  "name": "navy-cmms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/platform/db/migrate-cli.ts",
    "dev": "tsx src/main.ts",
    "check:boundaries": "tsx tools/check-boundaries.ts",
    "verify": "npm run typecheck && npm run check:boundaries && npm test",
    "init-installation": "tsx src/platform/init-cli.ts",
    "seed:demo-org": "tsx src/modules/m01-organization/seed-cli.ts",
    "asset-tags": "tsx src/modules/m03-assets/seed-cli.ts",
    "seed:demo-assets": "tsx src/modules/m03-assets/seed-cli.ts --demo",
    "label-numbers": "tsx src/modules/m04-labels-survey/seed-cli.ts",
    "seed:demo-survey": "tsx src/modules/m04-labels-survey/seed-cli.ts --demo",
    "work-numbers": "tsx src/modules/m05-work/seed-cli.ts",
    "seed:demo-work": "tsx src/modules/m05-work/seed-cli.ts --demo",
    "store-numbers": "tsx src/modules/m07-stores/seed-cli.ts",
    "seed:demo-stores": "tsx src/modules/m07-stores/seed-cli.ts --demo",
    "create-admin": "tsx src/modules/m02-identity/bootstrap-cli.ts",
    "web:install": "npm ci --prefix web",
    "web:dev": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "verify:web": "npm run typecheck --prefix web && npm run test --prefix web && npm run build --prefix web"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "fflate": "0.8.2",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
